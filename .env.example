# Copy to .env. docker-compose overrides DATABASE_URL and STORAGE_DIR.
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Leave OPENAI_API_KEY empty to use the offline hashing embedder and
# extractive answers (no data leaves your machine).
OPENAI_API_KEY=
# Any OpenAI-compatible provider. Default is OpenAI; for Gemini use the URL below
# with EMBEDDING_MODEL=gemini-embedding-001 and LLM_MODEL=gemini-flash-lite-latest.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
